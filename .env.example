# Copy this file to `.env` and fill in real values:  cp .env.example .env
#
# Public config — safe to expose. NEXT_PUBLIC_* values are shipped to the browser
# and are baked in at build time.
PORT=3000
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STRIPE_KEY=pk_test_replace_me

# Secrets — DO NOT commit real values. Needed at runtime by the API route and
# by the migrate/seed scripts. The app refuses to run without them.
DATABASE_URL=postgres://user:password@localhost:5432/shutup_demo
STRIPE_SECRET_KEY=sk_test_replace_me
NEXTAUTH_SECRET=replace_with_a_long_random_string
